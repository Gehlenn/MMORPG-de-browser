/**
 * KingEldor.test.js
 * Test suite for King Eldor boss
 * Phase 3: New Zones
 */

const KingEldor = require('../KingEldor');
describe('KingEldor', () => {
  let kingEldor;
  let mockZone;
  beforeEach(() => {
    mockZone = {
      config: {
        id: 'eldoria'
      },
      getNearbyPlayers: jest.fn().mockReturnValue([])
    };
    kingEldor = new KingEldor(mockZone);
  });
  describe('Configuration', () => {
    test('should have correct boss ID', () => {
      expect(kingEldor.id).toBe('king_eldor');
    });
    test('should have correct name', () => {
      expect(kingEldor.name).toBe('King Eldor');
    });
    test('should have correct level', () => {
      expect(kingEldor.level).toBe(40);
    });
    test('should have correct location', () => {
      expect(kingEldor.location).toEqual({
        x: 1500,
        y: 600
      });
    });
  });
  describe('Boss Stats', () => {
    test('should have high HP appropriate for raid boss', () => {
      expect(kingEldor.maxHp).toBeGreaterThan(10000);
    });
    test('should have damage values', () => {
      expect(kingEldor.damage).toBeGreaterThan(100);
    });
    test('should have defense values', () => {
      expect(kingEldor.defense).toBeGreaterThan(0);
    });
  });
  describe('Phase System', () => {
    test('should have 4 phases', () => {
      expect(kingEldor.phases).toHaveLength(4);
    });
    test('should start in phase 1', () => {
      expect(kingEldor.currentPhase).toBe(1);
    });
    test('phase 1 should be The Kings Pride', () => {
      expect(kingEldor.phases[0].name).toBe("The King's Pride");
    });
    test('phase 2 should be Royal Decree', () => {
      expect(kingEldor.phases[1].name).toBe('Royal Decree');
    });
    test('phase 3 should be Desperate King', () => {
      expect(kingEldor.phases[2].name).toBe('Desperate King');
    });
    test('phase 4 should be Final Breath', () => {
      expect(kingEldor.phases[3].name).toBe('Final Breath');
    });
    test('should transition phases based on HP percentage', () => {
      // Phase 1: 100-70% HP
      expect(kingEldor.getPhaseForHpPercent(80)).toBe(1);
      // Phase 2: 70-40% HP
      expect(kingEldor.getPhaseForHpPercent(60)).toBe(2);
      // Phase 3: 40-10% HP
      expect(kingEldor.getPhaseForHpPercent(30)).toBe(3);
      // Phase 4: 10-0% HP
      expect(kingEldor.getPhaseForHpPercent(5)).toBe(4);
    });
  });
  describe('Abilities', () => {
    test('should have summon ability', () => {
      expect(kingEldor.abilities).toContain('summon_royal_guard');
    });
    test('should have shield bash ability', () => {
      expect(kingEldor.abilities).toContain('shield_bash');
    });
    test('should have royal command ability', () => {
      expect(kingEldor.abilities).toContain('royal_command');
    });
    test('should have last stand buff', () => {
      expect(kingEldor.abilities).toContain('last_stand');
    });
    test('should have final decree ability', () => {
      expect(kingEldor.abilities).toContain('final_decree');
    });
  });
  describe('Raid Requirements', () => {
    test('should require 3-5 players', () => {
      expect(kingEldor.minPlayers).toBe(3);
      expect(kingEldor.maxPlayers).toBe(5);
    });
    test('should have 6 hour respawn', () => {
      expect(kingEldor.respawnTime).toBe(6 * 60 * 60 * 1000); // 6 hours in ms
    });
  });
  describe('State Management', () => {
    test('should initialize in idle state', () => {
      expect(kingEldor.state).toBe('idle');
    });
    test('should track active encounters', () => {
      expect(kingEldor.encounter).toBeNull();
    });
    test('should track participants', () => {
      expect(kingEldor.participants).toEqual([]);
    });
  });
  describe('Combat', () => {
    test('should take damage', () => {
      const initialHp = kingEldor.currentHp;
      kingEldor.takeDamage(1000);
      expect(kingEldor.currentHp).toBe(initialHp - 1000);
    });
    test('should not go below 0 HP', () => {
      kingEldor.takeDamage(kingEldor.maxHp + 1000);
      expect(kingEldor.currentHp).toBe(0);
    });
    test('should heal', () => {
      kingEldor.currentHp = 5000;
      kingEldor.heal(1000);
      expect(kingEldor.currentHp).toBe(6000);
    });
    test('should not heal above max HP', () => {
      kingEldor.currentHp = kingEldor.maxHp - 100;
      kingEldor.heal(1000);
      expect(kingEldor.currentHp).toBe(kingEldor.maxHp);
    });
  });
  describe('Event Emission', () => {
    test('should emit encounter started event', done => {
      kingEldor.on('boss:encounter_started', data => {
        expect(data.bossId).toBe('king_eldor');
        done();
      });
      kingEldor.emit('boss:encounter_started', {
        bossId: 'king_eldor',
        players: []
      });
    });
    test('should emit phase transition event', done => {
      kingEldor.on('boss:phase_transition', data => {
        expect(data).toHaveProperty('fromPhase');
        expect(data).toHaveProperty('toPhase');
        done();
      });
      kingEldor.emit('boss:phase_transition', {
        fromPhase: 1,
        toPhase: 2
      });
    });
    test('should emit defeated event', done => {
      kingEldor.on('boss:defeated', data => {
        expect(data.bossId).toBe('king_eldor');
        expect(data).toHaveProperty('participants');
        done();
      });
      kingEldor.emit('boss:defeated', {
        bossId: 'king_eldor',
        participants: []
      });
    });
  });
  describe('Boss Data', () => {
    test('should return boss data for client', () => {
      const data = kingEldor.getBossData();
      expect(data).toHaveProperty('id');
      expect(data).toHaveProperty('name');
      expect(data).toHaveProperty('level');
      expect(data).toHaveProperty('currentHp');
      expect(data).toHaveProperty('maxHp');
      expect(data).toHaveProperty('currentPhase');
      expect(data).toHaveProperty('location');
    });
    test('should calculate HP percentage', () => {
      kingEldor.currentHp = kingEldor.maxHp / 2;
      const data = kingEldor.getBossData();
      expect(data.hpPercent).toBe(50);
    });
  });
});
