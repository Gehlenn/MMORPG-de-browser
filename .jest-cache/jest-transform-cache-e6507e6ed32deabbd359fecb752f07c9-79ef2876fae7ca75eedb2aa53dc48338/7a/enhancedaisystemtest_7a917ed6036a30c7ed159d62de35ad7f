        b: {
          c: 2
        }
      };
      const obj3 = {
        a: 1,
        b: {
          c: 3
        }
      };
      expect(deltaCompressor.deepEqual(obj1, obj2)).toBe(true);
      expect(deltaCompressor.deepEqual(obj1, obj3)).toBe(false);
    });
