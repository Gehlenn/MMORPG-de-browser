# Environment Variables Template
# Copy this file to .env.local for development or .env.production for production

NODE_ENV=development
VERSION=0.4.0

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/mmorpg
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Backend Configuration
BACKEND_URL=http://localhost:3000
BACKEND_PORT=3000
API_VERSION=v1

# Frontend Configuration
FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080

# Security Configuration
JWT_SECRET=your-32-character-secret-minimum
SESSION_SECRET=your-32-character-secret-minimum
CORS_ORIGIN=http://localhost:8080

# Monitoring Configuration
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info

# Game Configuration
GAME_NAME=Gehlenn MMORPG
MAX_PLAYERS_PER_SERVER=1000
SPAWN_RATE=1.0
DIFFICULTY_MULTIPLIER=1.0

# Monetization Configuration
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_SECRET_KEY=your-stripe-secret-key
WEBHOOK_SECRET=your-webhook-secret

# Performance Configuration
CACHE_TTL=3600
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Feature Flags
ENABLE_BETA=true
ENABLE_MONETIZATION=false
ENABLE_ANALYTICS=true
ENABLE_DEBUG=true
