{
    "name": "mmorpg-browser",
    "version": "0.4.0",
    "description": "Legacy of Komodo - MMORPG Browser v0.4.0: Client-Side AI Integration (AI Visualization, Player-AI Interaction, Performance Optimization)",
    "main": "server/server.js",
    "scripts": {
        "start": "node server/server.js",
        "dev": "nodemon server/server.js",
        "art:apply": "node scripts/apply-art-pipeline.js --input art/generated",
        "art:dry": "node scripts/apply-art-pipeline.js --input art/generated --dry-run",
        "assets:optimize": "node scripts/optimize-images.js",
        "error:log": "node scripts/generateErrorLog.js",
        "git:ensure": "node scripts/ensure-gitignore.js",
        "test": "jest",
        "test:enhanced-coverage": "node tests/enhanced-coverage-suite.js",
        "test:coverage": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":95,\"functions\":95,\"lines\":95,\"statements\":95}}'",
        "test:watch": "jest --watch",
        "test:regression": "jest tests/v0.4.0/regression.test.js",
        "test:integrity": "node tests/enhanced-coverage-suite.js --integrity-only",
        "lint": "eslint server/**/*.js",
        "lint:fix": "eslint server/**/*.js --fix",
        "docs": "jsdoc -c jsdoc.conf.json"
    },
    "dependencies": {
        "bcrypt": "^5.1.1",
        "canvas": "^3.2.1",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "crypto": "^1.0.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "lodash": "^4.17.21",
        "moment": "^2.29.4",
        "morgan": "^1.10.1",
        "socket.io": "^4.7.4",
        "socket.io-client": "^4.8.3",
        "sqlite3": "^5.1.6",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "^4.0.18",
        "eslint": "^8.55.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.3.0",
        "jsdoc": "^4.0.2",
        "jsdom": "^28.1.0",
        "nodemon": "^3.0.2",
        "playwright": "^1.58.2",
        "sharp": "^0.34.5",
        "supertest": "^6.3.3",
        "vitest": "^4.0.18"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "keywords": [
        "mmorpg",
        "browser",
        "game",
        "multiplayer",
        "socket.io",
        "nodejs",
        "javascript"
    ],
    "author": "MMORPG Browser Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/your-username/mmorpg-browser.git"
    }
}
