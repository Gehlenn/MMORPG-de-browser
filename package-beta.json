{
  "name": "eldoria-mmorpg-beta",
  "version": "1.0.0-beta",
  "description": "Legacy of Komodo - Aethelgard MMORPG Beta Version",
  "main": "server/server-beta.js",
  "scripts": {
    "start": "node server/server-beta.js",
    "dev": "nodemon server/server-beta.js",
    "test": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "playwright test",
    "test:performance": "node tests/performance/load-test.js",
    "test:coverage": "vitest --coverage",
    "build": "npm run build:client && npm run build:server",
    "build:client": "echo 'Client build completed'",
    "build:server": "echo 'Server build completed'",
    "lint": "eslint . --ext .js,.json",
    "lint:fix": "eslint . --ext .js,.json --fix",
    "format": "prettier --write .",
    "health": "curl http://localhost:3000/health",
    "logs": "tail -f logs/server.log",
    "backup": "npm run backup:db && npm run backup:cache",
    "backup:db": "node scripts/backup-database.js",
    "backup:cache": "node scripts/backup-cache.js",
    "restore": "npm run restore:db && npm run restore:cache",
    "restore:db": "node scripts/restore-database.js",
    "restore:cache": "node scripts/restore-cache.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "deploy": "npm run build && npm run deploy:staging",
    "deploy:staging": "echo 'Deploy para staging'",
    "deploy:production": "echo 'Deploy para produção'",
    "monitor": "node scripts/monitor.js",
    "benchmark": "node scripts/benchmark.js",
    "stress": "node scripts/stress-test.js",
    "clean": "npm run clean:logs && npm run clean:cache",
    "clean:logs": "rm -f logs/*.log",
    "clean:cache": "rm -rf cache/*"
  },
  "keywords": [
    "mmorpg",
    "browser",
    "game",
    "multiplayer",
    "websocket",
    "nodejs",
    "express",
    "socket.io",
    "beta",
    "legacy-of-komodo",
    "aethelgard"
  ],
  "author": "Eldoria MMORPG Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "sqlite3": "^5.1.6",
    "redis": "^4.6.7",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^6.7.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.0",
    "joi": "^17.9.2",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "winston": "^3.10.0",
    "nodemailer": "^6.9.7",
    "sharp": "^0.32.6",
    "multer": "^1.4.5-lts.1",
    "csv-parser": "^3.0.0",
    "node-cron": "^3.0.2",
    "cluster": "^0.7.7",
    "worker_threads": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "vitest": "^0.34.6",
    "@playwright/test": "^1.40.0",
    "eslint": "^8.49.0",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3",
    "nock": "^13.3.2",
    "sinon": "^15.2.0",
    "faker": "^6.6.6",
    "artillery": "^2.0.3",
    "clinic": "^12.1.0",
    "0x": "^7.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eldoria-mmorpg/legacy-of-komodo.git"
  },
  "bugs": {
    "url": "https://github.com/eldoria-mmorpg/legacy-of-komodo/issues"
  },
  "homepage": "https://github.com/eldoria-mmorpg/legacy-of-komodo#readme",
  "config": {
    "port": 3000,
    "database": {
      "type": "sqlite",
      "filename": "database/eldoria-beta.db"
    },
    "redis": {
      "host": "localhost",
      "port": 6379,
      "db": 0
    },
    "game": {
      "maxPlayers": 100,
      "maxMobs": 500,
      "worldWidth": 2000,
      "worldHeight": 2000,
      "tickRate": 60,
      "saveInterval": 30000
    },
    "logging": {
      "level": "info",
      "file": "logs/server.log",
      "maxSize": "10m",
      "maxFiles": 5
    },
    "security": {
      "rateLimitWindow": 900000,
      "rateLimitMax": 1000,
      "sessionTimeout": 3600000,
      "maxLoginAttempts": 5,
      "lockoutTime": 900000
    },
    "beta": {
      "features": {
        "debugMode": true,
        "adminCommands": true,
        "playerStats": true,
        "guildSystem": false,
        "auctionHouse": false,
        "pvpArena": false,
        "worldBoss": true,
        "events": true,
        "quests": true,
        "crafting": false,
        "housing": false
      },
      "restrictions": {
        "maxLevel": 50,
        "maxGold": 10000,
        "maxItemsPerPlayer": 100,
        "maxGuildMembers": 0,
        "maxPartySize": 4
      },
      "monitoring": {
        "enableMetrics": true,
        "enableProfiling": true,
        "enableDebugLogs": true,
        "enablePerformanceTracking": true
      }
    }
  },
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/eldoria-mmorpg"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "preferGlobal": false,
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
