# Production Environment Variables
NODE_ENV=production
VERSION=0.4.0

# Database Configuration
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# Redis Configuration
REDIS_URL=redis://default:[YOUR-PASSWORD]@[YOUR-REDIS-CLUSTER].redislabs.com:12345
REDIS_PASSWORD=[YOUR-PASSWORD]

# Backend Configuration
BACKEND_URL=https://[YOUR-BACKEND-PROJECT].railway.app
BACKEND_PORT=3000
API_VERSION=v1

# Frontend Configuration
FRONTEND_URL=https://[YOUR-FRONTEND-PROJECT].vercel.app
FRONTEND_PORT=80

# Security Configuration
JWT_SECRET=[YOUR-JWT-SECRET-32-CHARS-MIN]
SESSION_SECRET=[YOUR-SESSION-SECRET-32-CHARS-MIN]
CORS_ORIGIN=https://[YOUR-FRONTEND-PROJECT].vercel.app

# Monitoring Configuration
SENTRY_DSN=[YOUR-SENTRY-DSN]
LOG_LEVEL=info

# Game Configuration
GAME_NAME=Gehlenn MMORPG
MAX_PLAYERS_PER_SERVER=1000
SPAWN_RATE=1.0
DIFFICULTY_MULTIPLIER=1.0

# Monetization Configuration
STRIPE_PUBLIC_KEY=[YOUR-STRIPE-PUBLIC-KEY]
STRIPE_SECRET_KEY=[YOUR-STRIPE-SECRET-KEY]
WEBHOOK_SECRET=[YOUR-WEBHOOK-SECRET]

# Performance Configuration
CACHE_TTL=3600
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Feature Flags
ENABLE_BETA=true
ENABLE_MONETIZATION=false
ENABLE_ANALYTICS=true
ENABLE_DEBUG=false
